{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jQ Player",
  "version": "0.1.0",
  "identifier": "jq-player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "jQ Player",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "longDescription": "Free, native cue player for Linux and Windows for theatre operation",
    "shortDescription": "Cue player for theatre operation",
    "publisher": "Julius Henkelmann",
    "copyright": "Copyright © 2026 Julius Henkelmann",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "fileAssociations": [
      {
        "ext": ["jqshow"],
        "name": "jQ-Show",
        "description": "jQ-Player-Show",
        "role": "Editor",
        "mimeType": "application/x-jqplayer-show"
      }
    ],
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2", "libpipewire-0.3-0t64 | libpipewire-0.3-0"],
        "desktopTemplate": "linux/jq-player.desktop",
        "files": {
          "/usr/share/mime/packages/jq-player.xml": "linux/jq-player-mime.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/jq-player.desktop",
        "files": {
          "/usr/share/mime/packages/jq-player.xml": "linux/jq-player-mime.xml"
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": ["en-US", "de-DE"]
      },
      "nsis": {
        "installMode": "both",
        "languages": ["English", "German"],
        "customLanguageFiles": {
          "German": "windows/German.nsh"
        },
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
