{
  "format": "jqlibrary",
  "version": 1,
  "id": "ddad2594-fb4e-4094-9c37-e7f283ecf29f",
  "revision": 1,
  "name": {
    "en": "Behringer X32 / Midas M32",
    "de": "Behringer X32 / Midas M32"
  },
  "description": {
    "en": "Mutes, faders, sends, DCAs, mute groups, scenes, snippets and show cues over OSC. Set the console's IP address in the show's network devices; the X32 listens on UDP port 10023.",
    "de": "Stummschaltungen, Fader, Sends, DCAs, Mute-Gruppen, Szenen, Snippets und Show-Cues über OSC. Die IP-Adresse des Pults in den Netzwerkgeräten der Show eintragen; das X32 empfängt auf UDP-Port 10023."
  },
  "author": "jQ Player",
  "min_app": "0.5.0",
  "devices": [
    {
      "id": "x32",
      "name": {
        "en": "X32",
        "de": "X32"
      },
      "port": 10023
    }
  ],
  "categories": [
    {
      "id": "mute",
      "name": {
        "en": "Mutes",
        "de": "Stummschaltungen"
      }
    },
    {
      "id": "fader",
      "name": {
        "en": "Faders",
        "de": "Fader"
      }
    },
    {
      "id": "send",
      "name": {
        "en": "Sends",
        "de": "Sends"
      }
    },
    {
      "id": "dca",
      "name": {
        "en": "DCAs and mute groups",
        "de": "DCAs und Mute-Gruppen"
      }
    },
    {
      "id": "scene",
      "name": {
        "en": "Scenes, snippets, cues",
        "de": "Szenen, Snippets, Cues"
      }
    },
    {
      "id": "misc",
      "name": {
        "en": "Other",
        "de": "Sonstiges"
      }
    }
  ],
  "presets": [
    {
      "id": "ch-mute",
      "revision": 1,
      "category": "mute",
      "title": {
        "en": "Ch {ch}: {state:label}",
        "de": "Kanal {ch}: {state:label}"
      },
      "description": {
        "en": "Mutes or unmutes an input channel (its ON button).",
        "de": "Schaltet einen Eingangskanal stumm oder wieder ein (ON-Taste)."
      },
      "params": [
        {
          "id": "ch",
          "label": {
            "en": "Channel",
            "de": "Kanal"
          },
          "type": "int",
          "min": 1,
          "max": 32,
          "default": 1
        },
        {
          "id": "state",
          "label": {
            "en": "Action",
            "de": "Aktion"
          },
          "type": "choice",
          "values": [
            {
              "value": 0,
              "label": {
                "en": "Mute",
                "de": "Stummschalten"
              }
            },
            {
              "value": 1,
              "label": {
                "en": "Unmute",
                "de": "Stummschaltung aufheben"
              }
            }
          ],
          "default": 0
        }
      ],
      "cue": {
        "type": "osc",
        "device": "x32",
        "messages": [
          {
            "address": "/ch/{ch:02}/mix/on",
            "args": [
              {
                "int": "{state}"
              }
            ]
          }
        ]
      },
      "keywords": {
        "en": [
          "off",
          "on",
          "silence",
          "mute"
        ],
        "de": [
          "aus",
          "an",
          "stumm",
          "Mute"
        ]
      }
    },
