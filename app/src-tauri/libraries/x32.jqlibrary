    {
      "id": "ch-fader",
      "revision": 1,
      "category": "fader",
      "title": {
        "en": "Ch {ch} fader to {level:raw} dB",
        "de": "Kanal {ch} Fader auf {level:raw} dB"
      },
      "description": {
        "en": "Sets the fader of an input channel (−90 dB is off).",
        "de": "Stellt den Fader für einen Eingangskanal (−90 dB ist aus)."
      },
      "params": [
        {
          "id": "ch",
          "label": {
            "en": "Channel",
            "de": "Kanal"
          },
          "type": "int",
          "min": 1,
          "max": 32,
          "default": 1
        },
        {
          "id": "level",
          "label": {
            "en": "Level",
            "de": "Pegel"
          },
          "type": "float",
          "min": -90,
          "max": 10,
          "default": 0,
          "step": 0.5,
          "unit": "dB",
          "map": [
            [
              -90,
              0
            ],
            [
              -60,
              0.0625
            ],
            [
              -30,
              0.25
            ],
            [
              -10,
              0.5
            ],
            [
              10,
              1
            ]
          ]
        }
      ],
      "cue": {
        "type": "osc",
        "device": "x32",
        "messages": [
          {
            "address": "/ch/{ch:02}/mix/fader",
            "args": [
              {
                "float": "{level}"
              }
            ]
          }
        ]
      },
      "keywords": {
        "en": [
          "volume",
          "level",
          "dB",
          "fader"
        ],
        "de": [
          "Lautstärke",
          "Pegel",
          "dB",
          "Fader"
        ]
      }
    },
